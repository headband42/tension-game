{
  "name": "tension-game",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:web\"",
    "dev:server": "cd apps/server && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "build": "bun run build:server && bun run build:web",
    "build:server": "cd apps/server && bun run build",
    "build:web": "cd apps/web && bun run build",
    "db:generate": "cd apps/server && bunx prisma generate",
    "db:migrate": "cd apps/server && bunx prisma migrate dev",
    "db:studio": "cd apps/server && bunx prisma studio",
    "db:seed": "cd apps/server && bun run seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
