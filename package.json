{
  "name": "tension-game",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bun run --cwd apps/server setup",
    "dev": "bun run --parallel dev:server dev:web",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/server start",
    "test": "bun run --cwd apps/server test",
    "check": "bun run --cwd apps/server check && bun run --cwd apps/web check",
    "import": "bun apps/server/src/content/import-cli.ts",
    "db:migrate": "bun run --cwd apps/server db:migrate",
    "db:reset": "bun run --cwd apps/server db:reset",
    "db:studio": "bun run --cwd apps/server db:studio"
  },
  "engines": {
    "bun": ">=1.2"
  }
}
