{
  "name": "@tension/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "dev": "bun --watch src/index.ts --api-only",
    "start": "bun src/index.ts",
    "test": "bun test",
    "check": "prisma generate --no-hints && tsc --noEmit",
    "import": "bun src/content/import-cli.ts",
    "seed": "bun src/content/import-cli.ts data/questions.json",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force --skip-seed && bun run seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@prisma/client": "^6.19.3",
    "@tension/shared": "workspace:*",
    "hono": "^4.13.13",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "prisma": "^6.19.3",
    "socket.io-client": "^4.8.4",
    "typescript": "^6.0.3"
  }
}
