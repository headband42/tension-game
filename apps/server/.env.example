# SQLite database, relative to prisma/schema.prisma. `bun run setup` copies this file to .env.
DATABASE_URL="file:./dev.db"

# Optional: port and interface for the game server (defaults: 3001 on all interfaces).
# PORT=3001
# HOST=0.0.0.0

# Password for the question manager at /admin, which shows and edits every answer. `bun run setup`
# fills in a random one. Set it to "" to turn the manager off.
# ADMIN_PASSWORD="choose-a-password"
