# SQLite database, relative to prisma/schema.prisma. `bun run setup` copies this file to .env.
DATABASE_URL="file:./dev.db"

# Optional: port and interface for the game server (defaults: 3001 on all interfaces).
# PORT=3001
# HOST=0.0.0.0

# Optional: a password for the question manager at /admin, which shows and edits every answer.
# Without one, anyone who can reach the server can open it. That's fine among friends; set one when
# players you don't know join in, as at a bar trivia night.
# ADMIN_PASSWORD="choose-a-password"
