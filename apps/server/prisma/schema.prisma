generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Question categories form a tree. `id` and `path` are both the slash-separated
/// path, e.g. "geography/mountains".
model Category {
  id        String     @id
  name      String
  parentId  String?    @map("parent_id")
  depth     Int        @default(0)
  path      String
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at")

  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryChildren")
  questions Question[]

  @@index([parentId])
  @@index([path])
  @@map("categories")
}

model Question {
  id            String         @id @default(cuid())
  categoryId    String         @map("category_id")
  difficulty    Int            @default(1)
  questionText  String         @map("question_text")
  /// Answers ranked at or above the cutoff score their rank; lower-ranked ones are tension.
  tensionCutoff Int            @default(10) @map("tension_cutoff")
  submitter     String?
  source        String?
  tags          String         @default("[]") /// JSON string array
  active        Boolean        @default(true)
  /// How many games have drawn this question; less-used questions are picked first.
  usageCount    Int            @default(0) @map("usage_count")
  createdAt     DateTime       @default(now()) @map("created_at")

  category      Category       @relation(fields: [categoryId], references: [id])
  answers       Answer[]
  games         GameQuestion[]

  @@index([categoryId])
  @@index([difficulty])
  @@index([active])
  @@map("questions")
}

model Answer {
  id           String   @id @default(cuid())
  questionId   String   @map("question_id")
  rank         Int
  answerText   String   @map("answer_text")
  displayValue String?  @map("display_value")
  aliases      String   @default("[]") /// JSON string array

  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([questionId, rank])
  @@map("answers")
}

model Game {
  id                 String         @id @default(cuid())
  code               String         @unique
  /// Secret proving a socket is the host. Never sent to players.
  hostToken          String         @map("host_token")
  status             String         @default("waiting") /// waiting | active | completed
  /// Last round that was started.
  currentRound       Int            @default(0) @map("current_round")
  totalRounds        Int            @default(5) @map("total_rounds")
  timePerRound       Int            @default(45) @map("time_per_round")
  doublesPerPlayer   Int            @default(1) @map("doubles_per_player")
  selectedCategories String         @default("[]") @map("selected_categories") /// JSON string array
  createdAt          DateTime       @default(now()) @map("created_at")
  startedAt          DateTime?      @map("started_at")
  completedAt        DateTime?      @map("completed_at")

  players            Player[]
  submissions        Submission[]
  questions          GameQuestion[]

  @@index([status])
  @@map("games")
}

model GameQuestion {
  id          String    @id @default(cuid())
  gameId      String    @map("game_id")
  questionId  String    @map("question_id")
  roundNumber Int       @map("round_number")
  askedAt     DateTime? @map("asked_at")

  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  question    Question  @relation(fields: [questionId], references: [id])

  @@unique([gameId, roundNumber])
  @@index([gameId])
  @@map("game_questions")
}

model Player {
  id               String       @id @default(cuid())
  gameId           String       @map("game_id")
  name             String
  /// Random id stored in the phone's browser so a player can rejoin after a refresh.
  deviceId         String       @map("device_id")
  score            Int          @default(0)
  doublesRemaining Int          @default(1) @map("doubles_remaining")
  joinedAt         DateTime     @default(now()) @map("joined_at")

  game             Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  submissions      Submission[]

  @@index([gameId])
  @@map("players")
}

model Submission {
  id               String    @id @default(cuid())
  gameId           String    @map("game_id")
  playerId         String    @map("player_id")
  round            Int
  submittedAnswer  String    @map("submitted_answer")
  normalizedAnswer String?   @map("normalized_answer")
  answerMatchId    String?   @map("answer_match_id")
  matchedRank      Int?      @map("matched_rank")
  pointsAwarded    Int?      @map("points_awarded")
  usedDouble       Boolean   @default(false) @map("used_double")
  /// Null when the answer was auto-locked at the end of the round.
  lockedAt         DateTime? @map("locked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  game             Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player           Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([gameId, round])
  @@map("submissions")
}
